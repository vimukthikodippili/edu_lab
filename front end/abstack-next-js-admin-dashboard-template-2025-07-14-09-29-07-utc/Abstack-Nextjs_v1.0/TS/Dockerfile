# ─── Stage 1: Install dependencies ───────────────────────────────────────────
FROM node:20-alpine AS deps

WORKDIR /app

# Install libc6-compat — required by some native Node addons on Alpine
RUN apk add --no-cache libc6-compat

# Copy only the package files first for better layer caching.
# node_modules is rebuilt only when package.json or package-lock.json changes.
COPY package.json package-lock.json .npmrc ./

# .npmrc already sets legacy-peer-deps=true; explicit flag as a safety net
RUN npm ci --legacy-peer-deps

# ─── Stage 2: Build the Next.js application ──────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy installed node_modules from deps stage
COPY --from=deps /app/node_modules ./node_modules

# Copy the entire source
COPY . .

# Build-time arguments — injected by docker build --build-arg or the CI workflow.
# NEXT_PUBLIC_* variables are baked into the client bundle at build time by Next.js.
ARG NEXTAUTH_SECRET
ARG NEXTAUTH_URL
ARG NEXT_PUBLIC_API_URL
ARG NODE_ENV=production

ENV NEXTAUTH_SECRET=$NEXTAUTH_SECRET
ENV NEXTAUTH_URL=$NEXTAUTH_URL
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NODE_ENV=$NODE_ENV

# Disable serwist service worker registration in the production Docker build.
# The service worker is only useful in browser PWA context, not during SSR.
ENV NEXT_PUBLIC_SW_DEV=false

# next build generates .next/standalone/ because next.config.ts has output: 'standalone'
RUN npm run build

# ─── Stage 3: Production runtime (minimal image) ─────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

RUN apk add --no-cache libc6-compat

# Security: run as a non-root system user
RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Copy only what is needed to run the server.
# .next/standalone contains a self-contained Node.js server (server.js)
# that does not require node_modules to be installed in the container.
COPY --from=builder /app/public ./public
COPY --from=builder --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=builder --chown=nextjs:nodejs /app/.next/static ./.next/static

USER nextjs

EXPOSE 3000

ENV PORT=3000
ENV HOSTNAME="0.0.0.0"

# server.js is generated by next build when output: 'standalone' is set
CMD ["node", "server.js"]
