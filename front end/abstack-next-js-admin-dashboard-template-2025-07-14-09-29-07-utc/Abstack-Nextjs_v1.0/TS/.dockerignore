# Exclude large/generated directories from the Docker build context.
# This keeps the build context small and prevents stale artifacts leaking in.

node_modules/
.next/
out/
coverage/
test-results/
.vercel/

# Env files — secrets must come in as build-args, not copied from disk
.env
.env.local
.env.staging
.env.production
.env.*.local

# Dev tooling not needed in image
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__/
.nyc_output/

# OS / IDE
.DS_Store
.vscode/
.idea/
Thumbs.db
