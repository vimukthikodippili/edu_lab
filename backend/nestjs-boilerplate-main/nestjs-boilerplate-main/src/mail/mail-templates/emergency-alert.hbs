<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Emergency Alert</title>
</head>
<body style="margin:0;font-family:arial">
  <table style="border:0;width:100%;max-width:600px;margin:0 auto">
    <tr style="background:#dc2626">
      <td style="padding:20px;color:#ffffff;text-align:center;font-size:22px;font-weight:700;letter-spacing:1px">
        ⚠ URGENT — {{app_name}}
      </td>
    </tr>
    <tr>
      <td style="padding:24px 24px 8px;color:#111827;font-size:16px;font-weight:100;line-height:1.6">
        Dear {{recipientName}},
      </td>
    </tr>
    <tr>
      <td style="padding:8px 24px 24px;color:#111827;font-size:16px;font-weight:100;line-height:1.6">
        {{message}}
      </td>
    </tr>
    <tr style="background:#f3f4f6">
      <td style="padding:12px 24px;color:#6b7280;font-size:12px">
        This is an automated emergency notification from {{app_name}}.
        Please do not reply to this email.
      </td>
    </tr>
  </table>
</body>
</html>
