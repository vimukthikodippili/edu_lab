# .env.ci — Non-secret CI environment template for SIMS
# SAFE TO COMMIT — no real secrets here.
# All secret values are injected via GitHub Secrets in the workflow YAML.
# This file documents the full list of required environment variables.

# ── App ──────────────────────────────────────────────────────────────
NODE_ENV=test
APP_PORT=3000
APP_NAME=SIMS API
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:5001
BACKEND_DOMAIN=http://localhost:5000

# ── Database (matches GitHub Actions services: block in pr-checks.yml) ──
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=root
DATABASE_PASSWORD=secret
DATABASE_NAME=api
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# ── Mail (unit tests do not send real email) ─────────────────────────
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@sims.edu.lk
MAIL_DEFAULT_NAME=SIMS
MAIL_CLIENT_PORT=1080

# ── File storage ─────────────────────────────────────────────────────
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

# ── OAuth (not tested in unit CI) ────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_APP_AUDIENCE=[]

# ── Auth secrets — REAL values injected via GitHub Secrets ───────────
# These placeholders document the required secret names.
# Set these in GitHub → Settings → Secrets and variables → Actions.
AUTH_JWT_SECRET=REPLACE_WITH_GITHUB_SECRET
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=REPLACE_WITH_GITHUB_SECRET
AUTH_REFRESH_TOKEN_EXPIRES_IN=3650d
AUTH_FORGOT_SECRET=REPLACE_WITH_GITHUB_SECRET
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=REPLACE_WITH_GITHUB_SECRET
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

# ── Next.js — REAL values injected via GitHub Secrets ────────────────
NEXTAUTH_SECRET=REPLACE_WITH_GITHUB_SECRET
NEXTAUTH_URL=http://localhost:5001
NEXT_PUBLIC_API_URL=http://localhost:5000/api
